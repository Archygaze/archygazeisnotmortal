# ============================================
# Discord Configuration
# ============================================
# 1. Create an app at https://discord.com/developers/applications
# 2. Under Bot -> Privileged Gateway Intents -> enable "Message Content Intent"
# 3. Copy the Bot Token here
DISCORD_TOKEN=

# Comma-separated Discord Channel IDs where the bot auto-replies to every conversation
# Tip: You can also manage channels live in Discord using /channel_add and /channel_remove
AUTO_REPLY_CHANNEL_IDS=

# Comma-separated Discord User IDs allowed to run admin slash commands (/channel_add, /persona_reload, etc.)
# Tip: Enable Developer Mode in Discord Settings -> Advanced, then right-click your profile -> Copy User ID
OWNER_USER_IDS=

# Also reply when @mentioned, replied to, or messaged in DMs? (true / false)
REPLY_ON_MENTION=true
REPLY_IN_DMS=true

# Messages starting with this prefix are ignored (useful to chat without triggering the bot)
IGNORE_PREFIX=//

# Seconds to wait to batch rapid consecutive messages before replying
DEBOUNCE_SECONDS=1.5

# Minimum seconds between bot replies in the same channel
CHANNEL_COOLDOWN_SECONDS=2.0

# Number of recent messages remembered per channel/DM
MEMORY_WINDOW=24

# ============================================
# AI Provider Configuration (Free Options)
# ============================================
# Choose one: groq | gemini | openrouter | ollama | openai_compatible
#
# Free options:
#   groq       -> Free developer API (very fast, great daily limits) - https://console.groq.com/keys
#   gemini     -> Google AI Studio free tier - https://aistudio.google.com/apikey
#   openrouter -> Free open-weight models (`openrouter/free`) - https://openrouter.ai/keys
#   ollama     -> 100% free forever, runs locally on your PC/GPU - https://ollama.com
AI_PROVIDER=groq

# Leave blank to use the recommended default model for the chosen provider:
#   groq:       llama-3.3-70b-versatile
#   gemini:     gemini-3.8-flash
#   openrouter: openrouter/free
#   ollama:     llama3.2
AI_MODEL=

# Fill in the API key for whichever provider(s) you use:
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Custom endpoints (usually keep defaults unless using a remote server)
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=

# Optional automatic fallback if your primary free API hits rate limits (429) or errors
# Example: FALLBACK_AI_PROVIDER=openrouter
FALLBACK_AI_PROVIDER=
FALLBACK_AI_MODEL=

# Response style tuning
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=350

# ============================================
# Persona & Persistence
# ============================================
PERSONA_FILE=persona.md
# Optional: paste persona markdown directly as a secret env var when deploying without persona.md on disk
# PERSONA_CONTENT=
DATABASE_PATH=data/memory.db
# Auto-delete saved conversation messages older than N hours (0 disables time-based expiry)
MEMORY_TTL_HOURS=24

